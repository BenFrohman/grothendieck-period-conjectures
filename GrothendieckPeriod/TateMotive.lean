import GrothendieckPeriod.GPC
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Unconditional Proof of GPC^{1}(ℙ^{1}) and Functoriality

This module provides:
1. An explicit, concrete instantiation P1_H2 of VarietyCohomology 1 modeling
   the cohomology of the projective line H^{2}(ℙ^{1}) (the Tate motive ℚ(-1)),
   where H_dR = ℚ, H_Betti = ℚ, the period pairing is (γ, α) ↦ γ * α * (2πi),
   and the algebraic cycle subspace is generated by the hyperplane class (⊤).
2. An **unconditional, sorry-free** proof GPC_P1_H2 : GPC P1_H2.
3. A morphism structure CohomologyHom and an unconditional proof that
   HasRationalPeriods is preserved under pullbacks.
-/

namespace GrothendieckPeriod

/-- The period pairing (γ, α) ↦ γ * α * (2πi) on ℚ × ℚ → ℂ,
bilinear over ℚ. -/
noncomputable def tatePeriodPairing : ℚ →ₗ[ℚ] ℚ →ₗ[ℚ] ℂ where
  toFun γ :=
    { toFun := fun α => (γ : ℂ) * (α : ℂ) * (2 * Real.pi * Complex.I)
      map_add' := fun α₁ α₂ => by
        push_cast
        ring
      map_smul' := fun c α => by
        simp only [smul_eq_mul, RingHom.id_apply]
        push_cast
        ring }
  map_add' γ₁ γ₂ := by
    ext α
    simp only [LinearMap.coe_mk, AddHom.coe_mk, LinearMap.add_apply]
    push_cast
    ring
  map_smul' c γ := by
    ext α
    simp only [smul_eq_mul, LinearMap.coe_mk, AddHom.coe_mk, RingHom.id_apply,
      LinearMap.smul_apply]
    push_cast
    ring

/-- Explicit cohomological realization of H^{2}(ℙ^{1}) (the Tate motive ℚ(-1)).
Every cohomology class in H^{2}(ℙ^{1}) is a rational multiple of the hyperplane class,
so algebraicCycleSubspace = ⊤. -/
noncomputable def P1_H2 : VarietyCohomology 1 where
  H_dR := ℚ
  H_Betti := ℚ
  periodPairing := tatePeriodPairing
  algebraicCycleSubspace := ⊤
  cycle_periods_rational := by
    intro α _ γ
    refine ⟨γ * α, ?_⟩
    simp only [tatePeriodPairing, LinearMap.coe_mk, AddHom.coe_mk, pow_one]
    push_cast
    ring

/-- **Unconditional theorem**: Bost–Charles's GPC^{1}(ℙ^{1}) holds without any
transcendence hypotheses, because the hyperplane class spans H^{2}_{dR}(ℙ^{1}). -/
theorem GPC_P1_H2 : GPC P1_H2 := by
  intro _ _
  exact Submodule.mem_top

/-- Consequently, a class in H^{2}_{dR}(ℙ^{1}) is algebraic if and only if
its normalized periods are rational (unconditional). -/
theorem P1_H2_cycle_iff_rational_periods (α : P1_H2.H_dR) :
    α ∈ P1_H2.algebraicCycleSubspace ↔ HasRationalPeriods P1_H2 α :=
  cycle_iff_rational_periods P1_H2 GPC_P1_H2 α

/-- A morphism of cohomological realizations compatible with the period pairing
(for instance, induced by a morphism of smooth projective varieties f : X → Y). -/
structure CohomologyHom {k : ℕ} (X Y : VarietyCohomology k) where
  pullback_dR : Y.H_dR →ₗ[ℚ] X.H_dR
  pushforward_Betti : X.H_Betti →ₗ[ℚ] Y.H_Betti
  /-- Adjunction / projection formula: ∫_γ f*α = ∫_{f_* γ} α -/
  pairing_compat :
    ∀ (γ : X.H_Betti) (α : Y.H_dR),
      X.periodPairing γ (pullback_dR α) = Y.periodPairing (pushforward_Betti γ) α

/-- **Unconditional theorem**: Having rational normalized periods is preserved
under pullback along any compatible morphism of cohomological realizations. -/
theorem HasRationalPeriods.pullback {k : ℕ} {X Y : VarietyCohomology k}
    (f : CohomologyHom X Y) {α : Y.H_dR} (hα : HasRationalPeriods Y α) :
    HasRationalPeriods X (f.pullback_dR α) := by
  intro γ
  rcases hα (f.pushforward_Betti γ) with ⟨q, hq⟩
  refine ⟨q, ?_⟩
  rw [f.pairing_compat, hq]

end GrothendieckPeriod
